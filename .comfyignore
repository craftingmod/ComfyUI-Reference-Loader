/*

# Required ComfyUI entry point
!/__init__.py

# Runtime directories
!/assets/
!/assets/**
!/backend/
!/backend/**
!/dist/
!/dist/**
!/presets/
!/presets/**
!/locales/
!/locales/**

# Distribution metadata
!/LICENSE
!/pyproject.toml
!/README.md
!/THIRD_PARTY_NOTICES.md
